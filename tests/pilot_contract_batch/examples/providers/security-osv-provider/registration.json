        "version": 1,
        "digest": "sha256:f42da97587e9cdb1395e1b29bfb6d71c5c41ec0fd01439353a08a3b930199619"
      },
      {
        "kind": "Capability",
        "name": "security.sbom.components",
        "version": 1,
        "digest": "sha256:8ba61aa6486cb5584135d6498c30940346d9dfef225202d2499e289314b90820"
      },
      {
        "kind": "CaptureKind",
        "name": "security.osv-matches",
        "digest": "sha256:f57af1f39ef99fdc4b95878633b597b67d52dc4234ef9bb11db08f214cdde059"
      },
      {
        "kind": "CaptureKind",
        "name": "security.osv-response",
        "digest": "sha256:c2a495dad58f29915ac2fda30d5a4d267a5c7beb905754337a531e99c8915292"
      },
      {
        "kind": "CaptureKind",
        "name": "security.sbom-components",
        "digest": "sha256:f1930d43df71ba059191224600bdb3334d5665b1a948b6ec91d4987f86922148"
      }
    ]
  },
