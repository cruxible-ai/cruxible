{
  "capture": "$steps.findings.document",
  "complete_when": {
    "count_at": "/count"
  },
  "fields": {
    "reported_at": {
      "at": "reported_at",
      "presence": "optional"
    },
    "rule": {
      "at": "rule",
      "presence": "optional"
    },
    "severity": {
      "at": "severity",
      "presence": "optional"
    },
    "tool": {
      "at": "tool",
      "presence": "optional"
    },
    "verification": {
      "at": "verification"
    }
  },
  "header": {
    "covered": {
      "at": "/covered",
      "type": "list<string{max_len: 256}>{max_items: 20000}"
    }
  },
  "id": "found",
  "key": {
    "locus": {
      "at": "locus",
      "type": "key_part<security.finding:locus>"
    },
    "repo": {
      "at": "repo",
      "type": "key_part<security.finding:repo>"
    },
    "weakness": {
      "at": "weakness",
      "type": "key_part<security.finding:weakness>"
    }
  },
  "kind": "extract",
  "records": "/findings/*",
  "row": {
    "digest": "sha256:89b733667e5379af29230e496b5bf182942cb251b0891be100444d3ed82b7d91",
    "name": "security.sarif-finding",
    "version": 1
  }
}
