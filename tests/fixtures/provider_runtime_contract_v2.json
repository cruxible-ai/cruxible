          "type": "array"
        },
        "declared_endpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Declared Endpoints",
          "type": "array"
        },
        "deterministic": {
          "title": "Deterministic",
          "type": "boolean"
        },
        "entrypoint": {
          "description": "module path and object, e.g. 'pkg.mod:Object'",
          "title": "Entrypoint",
          "type": "string"
        },
        "requires_extras": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires Extras",
          "type": "array"
