              "type": "integer"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "title": "ContractRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "One typed refusal an operation may return: its detail Contract.\n\n``absorbable`` declares that the refusal means \"this input is unavailable\",\nwhich a Line acquisition rule may absorb instead of failing the run.",
