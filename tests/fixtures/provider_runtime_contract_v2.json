  "schemas": {
    "Budgets": {
      "additionalProperties": false,
      "description": "Caps the executor enforces out-of-process.\n\n``cost_units`` travels with the run so a provider can report against it, but\nRP-0 enforces only the two caps it can enforce locally: wall clock and output\nsize. Cost enforcement belongs to the metering substrate.",
      "properties": {
        "cost_units": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Units"
        },
        "output_bytes": {
          "title": "Output Bytes",
          "type": "integer"
        },
        "wall_clock_seconds": {
          "title": "Wall Clock Seconds",
          "type": "number"
        }
      },
      "required": [
        "wall_clock_seconds",
        "output_bytes"
      ],
      "title": "Budgets",
      "type": "object"
    },
    "ContractRef": {
      "additionalProperties": false,
      "description": "A pin to one Contract version. Packages write ``name@N``; the install adds the digest.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maximum": 999999999,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "ImplementationManifest": {
      "additionalProperties": false,
      "description": "One entrypoint inside a provider package: how and where it runs.",
      "properties": {
        "backends": {
          "items": {
            "enum": [
              "local_env",
              "container"
            ],
            "type": "string"
