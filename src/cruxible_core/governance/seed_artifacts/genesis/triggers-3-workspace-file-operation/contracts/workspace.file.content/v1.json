{
  "artifact_format": "cruxible-contract-v1",
  "description": "A workspace file as text (utf-8) or as base64 bytes.",
  "fields": {
    "bom": {
      "optional": true,
      "type": {
        "kind": "bool"
      }
    },
    "byte_length": {
      "optional": true,
      "type": {
        "kind": "int",
        "min": 0
      }
    },
    "bytes": {
      "optional": true,
      "type": {
        "kind": "string"
      }
    },
    "character_count": {
      "optional": true,
      "type": {
        "kind": "int",
        "min": 0
      }
    },
    "encoding": {
      "type": {
        "kind": "enum",
        "members": [
          "base64",
          "utf-8"
        ]
      }
    },
    "kind": {
      "type": {
        "kind": "enum",
        "members": [
          "bytes",
          "text"
        ]
      }
    },
    "line_count": {
      "optional": true,
      "type": {
        "kind": "int",
        "min": 0
      }
    },
    "lines": {
      "optional": true,
      "type": {
        "item": {
          "kind": "string"
        },
        "kind": "list",
        "max_items": 1000000
      }
    },
    "newline": {
      "optional": true,
      "type": {
        "kind": "enum",
        "members": [
          "cr",
          "crlf",
          "lf",
          "mixed",
          "none"
        ]
      }
    },
    "text": {
      "optional": true,
      "type": {
        "kind": "string"
      }
    },
    "trailing_newline": {
      "optional": true,
      "type": {
        "kind": "bool"
      }
    }
  },
  "name": "workspace.file.content",
  "version": 1
}
