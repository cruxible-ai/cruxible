{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cruxible hook post-tool-use --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
